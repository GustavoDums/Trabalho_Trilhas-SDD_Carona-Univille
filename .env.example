# ==============================================================================
# Carona Univille - Variáveis de Ambiente de Exemplo (.env.example)
# PoC Acadêmica - Trilha 2 Spec-Driven Development
# ==============================================================================
# Instruções: Copie este arquivo para .env na raiz do projeto:
#   Copy-Item .env.example .env
# Em seguida, ajuste as credenciais do PostgreSQL conforme sua instalação local.
# ==============================================================================

# Configurações Centrais do Django
DJANGO_SECRET_KEY=django-insecure-carona-univille-dev-key-ficticia-exemplo-poc-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Configurações do Banco de Dados PostgreSQL (Princípios II e VI da Constitution)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=carona_univille_db
DB_USER=postgres
DB_PASSWORD=postgres_ficticio
DB_HOST=localhost
DB_PORT=5432

# Banco de Dados Fictício de Testes Automatizados
DB_TEST_NAME=carona_univille_test_db
